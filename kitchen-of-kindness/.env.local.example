NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_PASSWORD=your_site_password
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_api_key
DEPLOY_HOOK_URL=your_vercel_deploy_hook_url

# Admin login (checked on the server; see README "Mail tab")
ADMIN_PASSWORD=your_admin_password
ADMIN_SESSION_SECRET=long_random_string

# Mail tab (server only; never NEXT_PUBLIC_)
# "Connect Gmail" (Sign in with Google): an OAuth client from Google Cloud.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Older alternative to Google sign-in:
# GMAIL_USER=kitchen@gmail.com
# GMAIL_APP_PASSWORD=sixteen_letter_app_password
ANTHROPIC_API_KEY=your_claude_api_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
MAIL_CRON_SECRET=long_random_string
# Local testing: MAIL_FAKE=1 uses a made-up inbox and an in-memory database;
# MAIL_DRY_RUN=1 reads real mail but never sends or changes Gmail, and Yes / No
# in the Mail tab only practise (nothing is changed).
# MAIL_FAKE=1
# MAIL_DRY_RUN=1
